{
  "name": "tapthat",
  "version": "0.1.0",
  "private": true,
  "description": "Comment on any live webpage, then apply the feedback with a coding agent.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "keywords": [
    "chrome-extension",
    "arc-browser",
    "annotation",
    "code-review",
    "ai-agent",
    "developer-tools"
  ],
  "scripts": {
    "build": "npm run build -w @tapthat/extension",
    "dev": "npm run dev -w @tapthat/extension",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run check --workspaces --if-present",
    "package": "npm run package -w @tapthat/extension",
    "fixture": "npm run fixture -w @tapthat/extension"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
